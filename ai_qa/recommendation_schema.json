{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UniMeal meal plan response",
  "type": "object",
  "required": ["plan", "shopping_notes", "assumptions", "safety_notice"],
  "properties": {
    "plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["day", "meals", "daily_estimated_cost_nzd"],
        "properties": {
          "day": { "type": "integer", "minimum": 1 },
          "meals": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["meal_type", "recipe_name", "servings", "estimated_cost_nzd", "prep_minutes"],
              "properties": {
                "meal_type": { "type": "string", "enum": ["breakfast", "lunch", "dinner", "snack"] },
                "recipe_name": { "type": "string", "minLength": 1 },
                "servings": { "type": "integer", "minimum": 1 },
                "estimated_cost_nzd": { "type": "number", "minimum": 0 },
                "prep_minutes": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "daily_estimated_cost_nzd": { "type": "number", "minimum": 0 }
        }
      }
    },
    "shopping_notes": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "safety_notice": { "type": "string" }
  }
}
