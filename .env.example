# Optional. The AI Helper falls back to a database summary without these.
# The MySQL password is NOT stored here anymore: the run.ps1 / test.ps1 scripts
# prompt for it at runtime and pass it via an environment variable.
# (可选) Gemini AI 配置。MySQL 密码不再写在这里，由 run.ps1 / test.ps1 运行时输入。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30
