# Copy this file to .env and fill in the values locally. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=unimeal
# Optional: DATABASE_URL overrides the DB_* fields above.
# Keep this secret stable across backend restarts. Generate a random value locally.
SESSION_SECRET=
ARK_API_KEY=
ARK_MODEL=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_TIMEOUT_SECONDS=30
